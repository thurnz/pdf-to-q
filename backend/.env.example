# Copy this file to .env and fill in values. Never commit .env.

# LLM provider: "gemini" | "openai_compat"
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Models are retired over time; check Google AI Studio for current model names
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# LLM retry settings (optional)
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_SECONDS=2.0

# OpenAI-compatible (Groq, Ollama, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_PAGE_COUNT=200

# Chunking & LLM document limits
CHUNK_MAX_CHARS=30000
MAX_CHUNKS=12
CHUNK_DELAY_SECONDS=0.0

# Rate limiting (requests per minute per IP on POST /jobs)
RATE_LIMIT_PER_MINUTE=5

# Retention period for uploaded/generated files (seconds)
FILE_RETENTION_SECONDS=3600

# CORS – comma-separated list of allowed origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173, http://127.0.0.1:5173


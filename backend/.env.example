# Copy this file to .env and fill in values. Never commit .env.

# LLM provider: "gemini" | "openai_compat"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI-compatible (Groq, Ollama, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_PAGE_COUNT=200

# Retention period for uploaded/generated files (seconds)
FILE_RETENTION_SECONDS=3600

# CORS – comma-separated list of allowed origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173


# Root gitignore

# Python / backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/storage/
backend/.env
*.egg-info/
.pytest_cache/

# Frontend / Node
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# General build output
dist/
build/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Never ignore agent customizations
!.agents/

